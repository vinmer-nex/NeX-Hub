# Скопируйте этот файл в .env и при необходимости измените значения.

# Команда редактора для кнопки «Редактор».
# Пусто = автоопределение (code -> code-insiders -> cursor).
# Можно указать "cursor", "code" или полный путь,
# например C:\Program Files\Microsoft VS Code\Code.exe
EDITOR_CMD=

# Максимальный размер файла для предпросмотра, в байтах.
# По умолчанию 20971520 (20 МБ).
# MAX_TEXT_SIZE=20971520
